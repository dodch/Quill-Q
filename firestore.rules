rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "dodchadam@gmail.com" ||
        request.auth.token.email == "dotchadam@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isApprovedUser() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved")
      );
    }

    function isTeacherOrAdmin() {
      return isSuperAdmin() || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher"
      );
    }

    function getUserGroup() {
      return (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              "group" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.group
        : ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            "academicDetail" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
            (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.academicDetail.matches('.*Grp 2.*') ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.academicDetail.matches('.*2ANG-AFF 2.*')))
            ? "grp2" : "grp1");
    }

    function canAccessGroup(targetGroup) {
      return isTeacherOrAdmin() || getUserGroup() == targetGroup;
    }

    // User profile document:
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin() || isTeacherOrAdmin());
      allow create: if isAuthenticated() && (
        request.auth.uid == userId && (
          ((request.auth.token.email == "dodchadam@gmail.com" || request.auth.token.email == "dotchadam@gmail.com") && request.resource.data.status == "approved" && request.resource.data.role == "admin") ||
          (request.resource.data.status == "pending")
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && (
          (resource.data.status == "pending" && request.resource.data.status == "pending") ||
          (request.resource.data.role == resource.data.role &&
           request.resource.data.status == resource.data.status)
        ))
      );
      allow delete: if isSuperAdmin();

      match /tasks/{taskId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      }
    }

    // Shared Homeworks (Group-separated):
    match /homeworks/{hwId} {
      allow read: if isApprovedUser() && canAccessGroup(resource.data.get('group', 'grp1'));
      allow create: if isApprovedUser() && canAccessGroup(request.resource.data.get('group', 'grp1')) && request.resource.data.userId == request.auth.uid;
      allow update: if isApprovedUser() && canAccessGroup(resource.data.get('group', 'grp1'));
      allow delete: if isApprovedUser() && canAccessGroup(resource.data.get('group', 'grp1')) && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    match /tasks/{taskId} {
      allow read: if isApprovedUser() && canAccessGroup(resource.data.get('group', 'grp1'));
      allow create: if isApprovedUser() && canAccessGroup(request.resource.data.get('group', 'grp1')) && request.resource.data.userId == request.auth.uid;
      allow update: if isApprovedUser() && canAccessGroup(resource.data.get('group', 'grp1'));
      allow delete: if isApprovedUser() && canAccessGroup(resource.data.get('group', 'grp1')) && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // Shared Quick Notes (Group-separated):
    match /quickNotes/{noteId} {
      allow read: if isApprovedUser() && canAccessGroup(resource.data.get('group', 'grp1'));
      allow create: if isApprovedUser() && canAccessGroup(request.resource.data.get('group', 'grp1')) && request.resource.data.userId == request.auth.uid;
      allow update: if isApprovedUser() && canAccessGroup(resource.data.get('group', 'grp1')) && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow delete: if isApprovedUser() && canAccessGroup(resource.data.get('group', 'grp1')) && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // Server-wide Timetables & Schedules (Group-separated):
    match /schedules/{dayId} {
      allow read: if isApprovedUser() && (
        isTeacherOrAdmin() ||
        (dayId.matches('grp2_.*') ? getUserGroup() == "grp2" : getUserGroup() == "grp1")
      );
      allow write: if isSuperAdmin();
    }

    // Class Chat (Group-separated channels):
    match /chats/{channelId}/messages/{messageId} {
      allow read: if isApprovedUser() && canAccessGroup(channelId == "grp2" ? "grp2" : "grp1");
      allow create: if isApprovedUser() && canAccessGroup(channelId == "grp2" ? "grp2" : "grp1") && request.resource.data.userId == request.auth.uid;
      allow update: if isApprovedUser() && canAccessGroup(channelId == "grp2" ? "grp2" : "grp1");
      allow delete: if isApprovedUser() && canAccessGroup(channelId == "grp2" ? "grp2" : "grp1") && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // Unified Subject Documents & Lesson Notes (Unified across all groups):
    match /subjects/{subjectId}/documents/{docId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser() && request.resource.data.authorId == request.auth.uid;
      allow update: if isApprovedUser() && (resource.data.authorId == request.auth.uid || isSuperAdmin());
      allow delete: if isApprovedUser() && (resource.data.authorId == request.auth.uid || isSuperAdmin());

      match /submissions/{studentId} {
        allow read: if isApprovedUser() && (request.auth.uid == studentId || isSuperAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher"));
        allow create: if isApprovedUser() && request.auth.uid == studentId;
        allow update: if isApprovedUser() && (request.auth.uid == studentId || isSuperAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher"));
        allow delete: if isApprovedUser() && (request.auth.uid == studentId || isSuperAdmin());
      }
    }

    // Allow approved users to read subscriber device tokens across users collection for multi-device broadcast
    match /{path=**}/fcmTokens/{tokenId} {
      allow read: if isApprovedUser();
      allow write: if isAuthenticated() && (request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId || isSuperAdmin());
    }
  }
}
