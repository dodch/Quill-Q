rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile document: only the authenticated owner can read and write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Personal user subcollections if any
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Shared server-wide homeworks and reminders
    // Any logged-in student/teacher can read and add homeworks
    // ONLY the user who created the reminder or homework can delete it!
    match /homeworks/{hwId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
