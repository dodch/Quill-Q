rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "dodchadam@gmail.com" ||
        request.auth.token.email == "dotchadam@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isApprovedUser() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved")
      );
    }

    // User profile document:
    // - SuperAdmin can read and write/update/delete any user (to approve, reject, manage role)
    // - Authenticated users can read their own profile, create their initial profile, and update non-security fields
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isAuthenticated() && (
        request.auth.uid == userId && (
          // Admin automatically approved, others start as pending
          ((request.auth.token.email == "dodchadam@gmail.com" || request.auth.token.email == "dotchadam@gmail.com") && request.resource.data.status == "approved" && request.resource.data.role == "admin") ||
          (request.resource.data.status == "pending")
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && 
         // Normal users cannot elevate their own role or approve themselves
         request.resource.data.role == resource.data.role &&
         request.resource.data.status == resource.data.status)
      );
      allow delete: if isSuperAdmin();

      // Personal user subcollections
      match /tasks/{taskId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      }
    }

    // Shared server-wide homeworks and reminders:
    // - Only approved students, teachers, and admin can read & create
    // - Only creator or super admin can delete
    match /homeworks/{hwId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser() && request.resource.data.userId == request.auth.uid;
      allow update: if isApprovedUser();
      allow delete: if isApprovedUser() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    match /tasks/{taskId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser() && request.resource.data.userId == request.auth.uid;
      allow update: if isApprovedUser();
      allow delete: if isApprovedUser() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // Shared server-wide Quick Notes on Subjects view:
    // - Only approved students, teachers, and admin can read & create
    // - Author or Super Admin can delete
    match /quickNotes/{noteId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser() && request.resource.data.userId == request.auth.uid;
      allow update: if isApprovedUser() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow delete: if isApprovedUser() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // Server-wide Timetables & Schedules:
    // - ONLY approved users can read/download the schedule
    // - ONLY Super Admin can create, modify, or delete schedules
    match /schedules/{dayId} {
      allow read: if isApprovedUser();
      allow write: if isSuperAdmin();
    }

    // Server-wide Class Chat
    // - Approved users can read and write chat messages
    // - Approved users can update seen status on messages
    // - Creator or super admin can delete messages
    match /chats/{channelId}/messages/{messageId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser() && request.resource.data.userId == request.auth.uid;
      allow update: if isApprovedUser();
      allow delete: if isApprovedUser() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // Subject Documents & Lesson Notes
    // - Only approved students, teachers, and admins can view subject documents
    // - Approved users can create documents
    // - Author or SuperAdmin can update or delete documents
    match /subjects/{subjectId}/documents/{docId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser() && request.resource.data.authorId == request.auth.uid;
      allow update: if isApprovedUser() && (resource.data.authorId == request.auth.uid || isSuperAdmin());
      allow delete: if isApprovedUser() && (resource.data.authorId == request.auth.uid || isSuperAdmin());
    }
  }
}


